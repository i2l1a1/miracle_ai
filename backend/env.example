POSTGRES_USER=miracle_user
POSTGRES_PASSWORD=miracle_password
POSTGRES_DB=miracle_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://miracle_user:miracle_password@db:5432/miracle_db

FLYWAY_URL=jdbc:postgresql://db:5432/miracle_db
FLYWAY_USER=miracle_user
FLYWAY_PASSWORD=miracle_password

SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1
REFRESH_TOKEN_EXPIRE_DAYS=7

USERNAME_FOR_PARSING=username
PASSWORD_FOR_PARSING=password

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=arcee-ai/trinity-mini:free

LOG_LEVEL=INFO
LOG_DIR=/app/logs